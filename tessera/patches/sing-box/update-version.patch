+// The application has its own version, separate from the core tag in C.Version.
+func installedApplicationVersion() (string, error) {
+	daemonPath, err := os.Executable()
+	if err != nil {
+		return "", err
+	}
+	_, applicationPath, err := installedApplicationPath(daemonPath)
+	if err != nil {
+		return "", err
+	}
+	identity, err := windowsExecutableIdentity(applicationPath)
+	if err != nil {
+		return "", err
+	}
+	return identity.version, nil
+}
